{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreBinaries": ["gh"],
  "rules": {
    "exports": "warn",
    "types": "warn"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["bin/**", "scripts/**"],
      "ignoreDependencies": [
        "@base-ui/react",
        "@hugeicons/core-free-icons",
        "@hugeicons/react",
        "@pierre/trees",
        "@tailwindcss/vite",
        "@tanstack/react-router",
        "@tanstack/react-start",
        "@tanstack/router-plugin",
        "@vitejs/plugin-react",
        "class-variance-authority",
        "clsx",
        "react",
        "react-dom",
        "shiki",
        "tailwind-merge",
        "tailwindcss",
        "vite"
      ]
    },
    "landing": {
      "entry": ["src/main.tsx"],
      "project": ["src/**"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/cli": {
      "entry": ["test/*.test.js"],
      "project": ["src/**", "test/**"],
      "ignoreDependencies": ["@review-tour/schema", "@review-tour/viewer"]
    },
    "packages/schema": {
      "entry": ["test/*.test.js"],
      "project": ["src/**", "test/**"]
    },
    "packages/viewer": {
      "entry": ["src/router.tsx", "src/routes/**/*.{ts,tsx}", "scripts/*.js", "test/*.test.js"],
      "project": ["src/**", "scripts/**", "test/**"],
      "ignore": ["src/components/ui/**"],
      "ignoreDependencies": ["@review-tour/schema", "@tanstack/router-plugin"]
    }
  }
}
