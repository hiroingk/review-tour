{
  "name": "review-tour",
  "version": "0.1.0",
  "description": "Create browser-based guided review tours from local git diffs.",
  "keywords": [
    "code-review",
    "codex",
    "diff",
    "git",
    "review-tour"
  ],
  "homepage": "https://github.com/hiroingk/review-tour#readme",
  "bugs": {
    "url": "https://github.com/hiroingk/review-tour/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiroingk/review-tour.git"
  },
  "bin": {
    "review-tour": "bin/review-tour.js"
  },
  "files": [
    "bin",
    "packages/cli/dist",
    "packages/schema/dist",
    "packages/viewer/dist",
    "skill-data",
    "skills",
    "skills-manifest.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./schema": {
      "types": "./packages/schema/dist/reviewTourSchema.d.ts",
      "import": "./packages/schema/dist/reviewTourSchema.js"
    },
    "./viewer": {
      "types": "./packages/viewer/dist/lib/index.d.ts",
      "import": "./packages/viewer/dist/lib/index.js"
    }
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build && vp run -r build:node && node packages/viewer/scripts/sanitize-dist.js",
    "changelog:draft": "node scripts/draft-changelog.mjs",
    "check": "vp run -r build:node && vp check",
    "install:local": "vp run build && sh scripts/install-local-bin.sh",
    "knip": "knip",
    "lint": "vp check --no-fmt",
    "prepare": "lefthook install",
    "set-version": "node scripts/set-version.mjs",
    "skills:check": "npx --yes skills add . --list && npx --yes skills use . --skill review-tour >/dev/null && pnpm --filter @review-tour/cli build && node packages/cli/dist/index.js skills list --json >/dev/null && node packages/cli/dist/index.js skills get core >/dev/null",
    "skills:lint": "node scripts/lint-skills.mjs",
    "skills:list": "npx --yes skills add . --list",
    "skills:manifest": "node scripts/generate-skills-manifest.mjs",
    "skills:manifest:check": "node scripts/generate-skills-manifest.mjs --check",
    "skills:prompt": "npx --yes skills use . --skill review-tour",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "verify": "pnpm run check && pnpm run skills:lint && pnpm run skills:manifest:check && pnpm run knip && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "^4.2.1",
    "@hugeicons/react": "^1.1.7",
    "@pierre/trees": "1.0.0-beta.4",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "@vitejs/plugin-react": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shiki": "4.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "knip": "^6.24.0",
    "lefthook": "^2.1.9",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "vite": "catalog:",
      "vitefu": "1.1.2",
      "vitest": "catalog:"
    },
    "peerDependencyRules": {
      "allowAny": [
        "vite",
        "vitest"
      ],
      "allowedVersions": {
        "vite": "*",
        "vitest": "*"
      }
    }
  }
}
